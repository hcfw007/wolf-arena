{
  "name": "wolf-arena",
  "version": "0.0.1",
  "description": "AI 狼人杀：9 个 LLM 互相欺骗、推理、投票的开源对战引擎",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "tsx src/cli.ts",
    "smoke": "tsx src/smoke.ts",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "dotenv": "^16.4.7",
    "openai": "^4.77.0"
  },
  "devDependencies": {
    "@ddyscn/lint-config": "^0.0.1",
    "@types/node": "^22.10.2",
    "eslint": "^10.4.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
